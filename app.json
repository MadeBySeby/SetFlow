{
  "expo": {
    "name": "SetFlow Fitness",
    "slug": "SetFlow",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "scheme": "setflow",
    "splash": {
      "image": "./assets/splashImage2.png",
      "resizeMode": "contain",
      "backgroundColor": "#050A30"
    },
    "userInterfaceStyle": "automatic",
    "resolutions": {
      "react-native-safe-area-context": "5.6.2"
    },
    "ios": {
      "splash": {
        "image": "./assets/splashImage2.png",
        "resizeMode": "contain",
        "backgroundColor": "#050A30"
      },
      "supportsTablet": true,
      "jsEngine": "hermes",
      "bundleIdentifier": "ge.seby.setflowfitness",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "googleServicesFile": "./android/app/google-services.json",
      "package": "com.anonymous.SetFlow",
      "versionCode": 7,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050A30"
      }
    },
    "assetBundlePatterns": ["**/*"],
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24,
            "enableProguardInReleaseBuilds": true,
            "javaMaxHeapSize": "4g",
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splashImage2.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#050A30"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/logo.png",
          "color": "#ffffff"
        }
      ],
      "expo-localization",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "FlowWidget",
              "displayName": "SetFlow",
              "description": "SetFlow Fitness widget",
              "supportedFamilies": ["systemSmall", "systemMedium"]
            }
          ]
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "14e750be-8398-4df2-b2a8-2a905c25db2b"
      }
    }
  }
}
